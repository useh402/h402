HA_ENV=local                          # local | testnet | mainnet
HA_PORT=8400
HA_PUBLIC_BASE_URL=http://127.0.0.1:8400
HA_DATABASE_URL=sqlite:///./humanapi.db   # or postgresql+psycopg://user:pass@host:5432/humanapi
HA_FACILITATOR_URL=http://127.0.0.1:8402
HA_FACILITATOR_SETTLE_TOKEN=demo-token
HA_PLATFORM_FEE_BPS=2000              # 20%
HA_ECHO_WORKER=true                   # local only: automatic workers answer tasks

HA_ROBINHOOD_ENABLED=true
HA_ROBINHOOD_NETWORK=eip155:46630
HA_ROBINHOOD_ASSET=                   # test token on testnet; USDG by default on mainnet
HA_ROBINHOOD_ESCROW_ADDRESS=          # payTo address that receives settlements
HA_ROBINHOOD_RPC_URL=                 # optional, for escrow balance reconciliation in /health

HA_SOLANA_ENABLED=true
HA_SOLANA_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
HA_SOLANA_ASSET=                      # mint; USDC by default on mainnet
HA_SOLANA_ESCROW_ADDRESS=             # owner wallet of the escrow token account
HA_SOLANA_RPC_URL=
