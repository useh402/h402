# HumanAPI task service in Docker. Copy to .env.docker and fill in. Never commit .env.docker.
HA_ENV=mainnet                       # local | testnet | mainnet
# Hosted Postgres, or the compose one: postgresql+psycopg://humanapi:humanapi@postgres:5432/humanapi
HA_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
HA_ADMIN_TOKEN=                      # operator token; make it long and random
HA_FACILITATOR_SETTLE_TOKEN=         # must equal HF_SETTLE_TOKEN of the facilitator

HA_ROBINHOOD_ENABLED=true
HA_ROBINHOOD_NETWORK=eip155:4663
HA_ROBINHOOD_ASSET=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
HA_ROBINHOOD_ESCROW_ADDRESS=0x530C2beDB048a658cB9fFD074eB7A75D68bfBd90
HA_ESCROW_CONTRACT=0x530C2beDB048a658cB9fFD074eB7A75D68bfBd90
HA_ESCROW_OPERATOR_PRIVATE_KEY=      # the contract's operator wallet
HA_SOLANA_ENABLED=false

HA_HOUSE_POSTER_ENABLED=false
HA_SCOUTS_ENABLED=false
HA_VERIFIER_ENABLED=false
HA_AI_GATEWAY_API_KEY=
